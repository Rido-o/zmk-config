#!/usr/bin/env bash
# Redraws docs/keymap.png and adds it to the commit when the keymap (or what draws it) is part of the commit.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

if git diff --cached --name-only | grep -qE '^(config/.*\.(keymap|dtsi|h)|config/info\.json|tools/draw-keymap\.py|flake\.lock)$'; then
  echo "pre-commit: redrawing docs/keymap.png"
  nix run .#draw-keymap
  git add docs/keymap.png
fi
