#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt { quick-tap-ms = <220>; };

// Shared by both hands' home row mods
#define HOME_ROW_MOD_TIMING \
    tapping-term-ms = <180>; \
    quick-tap-ms = <175>; \
    require-prior-idle-ms = <150>; \
    flavor = "balanced"; \
    hold-trigger-on-release;

/ {
    combos {
        compatible = "zmk,combos";

        bluetooth {
            bindings = <&mo 3>;
            key-positions = <41 36>;
            layers = <0 4>;
        };

        qwerty {
            bindings = <&tog 4>;
            key-positions = <48 53>;
        };

        bluetooth_2 {
            bindings = <&mo 3>;
            key-positions = <42 47>;
            layers = <0 4>;
        };

        gaming {
            bindings = <&tog 5>;
            key-positions = <36 47>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47>;
            HOME_ROW_MOD_TIMING
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            HOME_ROW_MOD_TIMING
        };
    };

    macros {
        arrow: arrow {
            compatible = "zmk,behavior-macro";
            display-name = "->";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
        };

        fat_arrow: fat_arrow {
            compatible = "zmk,behavior-macro";
            display-name = "=>";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GREATER_THAN>;
        };

        path_sep: path_sep {
            compatible = "zmk,behavior-macro";
            display-name = "::";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp COLON>;
        };

        attr: attr {
            compatible = "zmk,behavior-macro";
            display-name = "#[";
            #binding-cells = <0>;
            bindings = <&kp POUND &kp LBKT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC         &kp N1           &kp N2           &kp N3               &kp N4             &kp N5             &kp N6       &kp N7              &kp N8                &kp N9            &kp N0            &kp DEL
&kp GRAVE       &kp B            &kp F            &kp L                &kp K              &kp Q              &kp P        &kp G               &kp O                 &kp U             &kp DOT           &kp BACKSLASH
&caps_word     &hml LEFT_GUI N  &hml LEFT_ALT S  &hml LEFT_CONTROL H  &hml LEFT_SHIFT T  &kp M              &kp C        &hmr RIGHT_SHIFT Y  &hmr RIGHT_CONTROL A  &hmr RIGHT_ALT E  &hmr RIGHT_GUI I  &kp ENTER
&kp LEFT_SHIFT  &kp X            &kp V            &kp J                &kp D              &kp Z              &kp SQT      &kp W               &kp SLASH             &kp SEMI          &kp COMMA         &kp RIGHT_SHIFT
                                                  &kp ESC              &kp R              &lt 1 BACKSPACE    &lt 2 ENTER  &kp SPACE           &kp TAB
            >;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
&trans  &trans           &trans         &trans            &trans     &trans           &trans       &trans                &trans                 &trans      &trans             &trans
&trans  &kp QUESTION     &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS  &path_sep        &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR  &kp GRAVE          &trans
&trans  &kp EXCLAMATION  &kp ASTERISK   &kp AMPERSAND     &kp EQUAL  &kp FSLH         &kp POUND    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE    &kp UNDERSCORE     &trans
&trans  &kp TILDE        &kp PLUS       &kp LBKT          &kp RBKT   &kp PERCENT      &kp AT_SIGN  &fat_arrow            &arrow                 &kp BSLH    &attr              &trans
                                        &trans            &trans     &trans           &trans       &trans                &trans
            >;
        };

        navigation {
            display-name = "Navigation";
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6    &kp F7     &kp F8     &kp F9     &kp F10  &kp F11
&trans   &trans  &trans  &trans  &trans  &trans    &trans    &trans     &trans     &trans     &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans   &trans
                         &trans  &trans  &trans    &trans    &trans     &trans
            >;
        };

        bluetooth {
            display-name = "Bluetooth";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3    &studio_unlock   &bt BT_CLR     &trans       &trans      &trans  &trans  &trans  &bootloader
&trans        &trans        &trans          &trans          &trans           &trans         &trans       &trans      &trans  &trans  &trans  &trans
&trans        &trans        &trans          &trans          &trans           &trans         &trans       &trans      &trans  &trans  &trans  &trans
&trans        &trans        &trans          &trans          &trans           &trans         &trans       &trans      &trans  &trans  &trans  &trans
                                            &trans          &sys_reset       &bootloader    &bootloader  &sys_reset  &trans
            >;
        };

        qwerty {
            display-name = "Qwerty";
            bindings = <
&trans   &trans  &trans  &trans  &trans     &trans       &trans    &trans  &trans     &trans   &trans    &trans
&kp TAB  &kp Q   &kp W   &kp E   &kp R      &kp T        &kp Y     &kp U   &kp I      &kp O    &kp P     &trans
&trans   &kp A   &kp S   &kp D   &kp F      &kp G        &kp H     &kp J   &kp K      &kp L    &kp SEMI  &trans
&trans   &kp Z   &kp X   &kp C   &kp V      &kp B        &kp N     &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
                         &trans  &kp SPACE  &kp LCTRL    &kp BSPC  &trans  &trans
            >;
        };

        gaming {
            display-name = "Gaming";
            bindings = <
&trans   &none      &none   &none   &none      &none        &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB  &kp N1     &kp N2  &kp N3  &kp N4     &kp N5       &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp C      &kp A   &kp W   &kp D      &kp F        &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp LSHFT  &kp R   &kp S   &kp E      &kp G        &trans  &trans  &trans  &trans  &trans  &trans
                            &kp V   &kp SPACE  &kp LCTRL    &trans  &trans  &trans
            >;
        };
    };
};
